# ============================================================
# Velite QA Nexus — Backend environment variables
# ============================================================
# Copy this file to .env locally (never commit .env).
# In Coolify, paste each of these values in Settings → Environment Variables.

# ---- Core ----
PORT=8080
NODE_ENV=production
PUBLIC_URL=https://qa.velite.in

# ---- Google Drive (server-side, no user OAuth) ----
# Generated ONCE by visiting /setup.html after first deploy.
# See README.md → "Step 5: Generate the Drive refresh token".
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SHARED_FOLDER_ID=1cc9gYp2hwzOxLd1_MKzNbXS9ONrFNP6i

# Pins the subfolder holding the per-document doc-{id}.json files.
# STRONGLY RECOMMENDED. Without it the folder is found by name, and the shared
# folder has held three subfolders all called "Velite QA Nexus — Metadata" —
# two created half a second apart by a race in the old find-or-create code.
# The fallback picks the oldest match, which is correct but rests on a 0.5s
# timestamp gap and on nobody renaming the folder (note the em-dash).
# Pin it and none of that matters. The id is in the folder's Drive URL:
#   https://drive.google.com/drive/folders/<THIS PART>
# The server logs which folder it resolved, and whether it was pinned, at boot.
GOOGLE_METADATA_FOLDER_ID=1pvU4RNDJkgpWwrOAlpk_QzPIuzZfO5GN

# ---- MSG91 SMS (India) — OPTIONAL, requires DLT registration (5–10 business days) ----
# Leave MSG91_TEMPLATE_ID BLANK to disable SMS entirely (email-only mode is the default).
# When DLT template is approved, fill this in and SMS activates automatically.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
OWNER_MOBILE=9815042727
OWNER_MOBILE_COUNTRY_CODE=91

# ---- Email OTP (PRIMARY channel — used from day one, no DLT required) ----
# Uses Gmail SMTP. Owner receives OTP in their inbox; reads it to team members.
OWNER_EMAIL=velite@velite.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=velite@velite.in
SMTP_PASSWORD=your-google-app-password-not-your-real-password
# ↑ Generate an "App Password" at https://myaccount.google.com/apppasswords
#   (do NOT use your real Gmail password; use an app-specific one).

# ---- Security ----
# Random 64-char hex string — used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-64-char-hex-string
